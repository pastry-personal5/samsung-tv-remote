{
  "server_instruction": "Use the selected TV shown by list_tvs. Mutations need a fresh server epoch, explicit target and a unique operation key per user intent. A receipt means accepted, not that the TV changed. Look up a lost result with the same key; never auto-repeat an uncertain action. Pairing and forgetting require explicit target confirmation.",
  "shared_mutation_fields": {
    "server_epoch": "UUID from a current snapshot",
    "operation_key": "UUID generated once for this user intent"
  },
  "tools": [
    {
      "name": "list_tvs",
      "description": "List saved TVs, selected TV, epoch and generation; no TV network access.",
      "fields": []
    },
    {
      "name": "inspect_tv",
      "description": "Inspect saved TV configuration and connection facts; no physical state claim.",
      "fields": [
        "device_id"
      ]
    },
    {
      "name": "discover_tvs",
      "description": "Discover local Samsung TVs; returns expiring candidate IDs.",
      "fields": [
        "server_epoch",
        "operation_key"
      ]
    },
    {
      "name": "probe_tv",
      "description": "Probe one validated local host, optionally bound to its private candidate handle, and observe the full fingerprint before pairing.",
      "fields": [
        "server_epoch",
        "operation_key",
        "host",
        "candidate_id?"
      ]
    },
    {
      "name": "pair_tv",
      "description": "Pair or re-pair only after confirming one fresh observation and exact full fingerprint; TV approval is still required.",
      "fields": [
        "server_epoch",
        "operation_key",
        "host",
        "attempt_id",
        "observation_id",
        "fingerprint",
        "confirm_fingerprint",
        "label",
        "selection_generation",
        "device_id?",
        "recovery_transaction_id?"
      ]
    },
    {
      "name": "select_tv",
      "description": "Select a saved TV for every client; requires the generation you observed.",
      "fields": [
        "server_epoch",
        "operation_key",
        "device_id",
        "expected_generation"
      ]
    },
    {
      "name": "connect_tv",
      "description": "Connect to the selected saved TV; reports remote readiness, not power.",
      "fields": [
        "server_epoch",
        "operation_key",
        "device_id",
        "selection_generation"
      ]
    },
    {
      "name": "set_wake",
      "description": "Set wired or Wi-Fi Wake MAC and active interface for a saved TV; checks its config revision.",
      "fields": [
        "server_epoch",
        "operation_key",
        "device_id",
        "selection_generation",
        "expected_config_revision",
        "wired_mac?",
        "wifi_mac?",
        "active_interface?"
      ]
    },
    {
      "name": "remote_action",
      "description": "Send one semantic remote action to the selected TV; written means socket write only; PowerToggle may probe then Wake.",
      "fields": [
        "server_epoch",
        "operation_key",
        "device_id",
        "selection_generation",
        "action:PowerToggle|Up|Down|Left|Right|Enter|Back|Home|PlayPause|Play|Pause|Mute|VolumeUp|VolumeDown"
      ]
    },
    {
      "name": "wake_tv",
      "description": "Send at most one Wake packet to the selected TV, then observe remote readiness separately.",
      "fields": [
        "server_epoch",
        "operation_key",
        "device_id",
        "selection_generation"
      ]
    },
    {
      "name": "cancel_wake",
      "description": "Stop a named Wake operation's reconnect wait; a packet already sent cannot be recalled.",
      "fields": [
        "server_epoch",
        "operation_key",
        "operation_id",
        "device_id",
        "selection_generation"
      ]
    },
    {
      "name": "get_operation",
      "description": "Look up a lost receipt or terminal result by exactly one operation ID or key; optional wait up to 10 seconds never repeats the effect.",
      "fields": [
        "server_epoch",
        "operation_id?",
        "operation_key?",
        "wait_seconds?"
      ]
    },
    {
      "name": "forget_tv",
      "description": "Forget a saved TV and its credentials only with exact device ID confirmation; partial cleanup stays blocked.",
      "fields": [
        "server_epoch",
        "operation_key",
        "device_id",
        "expected_config_revision",
        "confirm_device_id"
      ]
    },
    {
      "name": "recover_pairing",
      "description": "Explicitly compensate interrupted pairing using the exact shared marker; never repeat setup automatically.",
      "fields": [
        "server_epoch",
        "operation_key",
        "device_id",
        "transaction_id",
        "confirm_device_id"
      ]
    },
    {
      "name": "recover_forget",
      "description": "Explicitly compensate interrupted forget using the exact shared marker; never repeat setup automatically.",
      "fields": [
        "server_epoch",
        "operation_key",
        "device_id",
        "transaction_id",
        "confirm_device_id"
      ]
    }
  ],
